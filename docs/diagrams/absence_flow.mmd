%% The special case: literal absence of a term
%% Current implementation reviewed 7 October 2026.
%% Generated by render_diagrams.py; edit definitions there for matching image exports.
flowchart TB
    claim["A complete constructed claim<br/>Example: The Constitution does not mention<br/>the term &quot;political party&quot;."]
    pattern["Recognised quoted absence pattern?<br/>Only explicit forms implemented in Python<br/>A concept or ordinary statement is not a lexical absence test"]
    semantic["Normal evidence-based verification<br/>Retrieve and interpret the complete proposition<br/>Validate source quotes and require blind review<br/>A word match does not establish the claim"]
    scan["Scan every loaded corpus chunk<br/>No model call inside the scan branch<br/>Record matching chunks, pages and chunks scanned<br/>Counts can include overlapping chunk matches"]
    found["Term found<br/>Literal absence contradicted<br/>Return matching source chunks"]
    missing["No match<br/>Conditional corpus-only support<br/>Assumes complete, faithful text"]

    claim --> pattern
    pattern -->|No: semantic claim| semantic
    pattern -->|Yes: literal quoted term| scan
    scan --> found
    scan --> missing

    classDef source fill:#EDF8F4,stroke:#0B806A,color:#17243B;
    class scan source;
    classDef control fill:#EFF4FE,stroke:#2457D6,color:#17243B;
    class claim,pattern control;
    classDef model fill:#F4F0FB,stroke:#7650B6,color:#17243B;
    class semantic model;
    classDef decision fill:#FFF7E8,stroke:#A56B13,color:#17243B;
    class found,missing decision;
    classDef store fill:#FFFFFF,stroke:#52647B,color:#17243B;
%% The scan covers the combined loaded corpus, uses substrings and normalizes case/whitespace. Scope is a limitation.
%% Practice also requires cited blind review. A lexical-scan result lacks that marker and is currently withheld.
