%% How an answer is established or withheld
%% Current implementation reviewed 7 October 2026.
%% Generated by render_diagrams.py; edit definitions there for matching image exports.
flowchart TB
    input["Question text and A-D options<br/>Python routes direct or numbered questions<br/>Gold keys and earlier verdicts are withheld from reviewers"]
    paired["Unsupported paired format<br/>Statement-I/II or assertion/reason<br/>Abstain before model retrieval"]
    parse["Numbered statements: build complete claims<br/>Parse stem, items, closing question and coded options<br/>Bind the stem predicate; reject failed or introduced wording"]
    prepare["Direct questions: prepare comparison evidence<br/>Search the stem and each alternative<br/>Deduplicate up to five selections per query; restore full pages"]
    facts["Assess each complete claim<br/>Fresh retrieval plus full pages and named Article context<br/>SUPPORTED / CONTRADICTED / INSUFFICIENT<br/>Validate quote references; blind review must agree"]
    options["Assess the exact answer fit of A-D<br/>SUPPORTED / RULED_OUT / INSUFFICIENT<br/>Validate quotes and screen wholly unrelated citations<br/>Blind option review must resolve the same unique answer"]
    map["Python strict statement mapping<br/>Resolved true and false statements form a truth pattern<br/>Map the pattern to one coded option; unresolved -> abstain"]
    resolve["Python strict direct decision<br/>Exactly one SUPPORTED and three RULED_OUT<br/>Missing evidence cannot rule out an alternative"]
    result["A-D with checked evidence, or ABSTAIN"]

    input --> paired
    input --> parse
    input --> prepare
    parse -->|"For each claim"| facts
    prepare -->|"Compare all options"| options
    facts --> map
    options --> resolve
    map --> result
    resolve --> result
    paired -.-> result

    classDef source fill:#EDF8F4,stroke:#0B806A,color:#17243B;
    classDef control fill:#EFF4FE,stroke:#2457D6,color:#17243B;
    class input,parse,prepare,map,resolve control;
    classDef model fill:#F4F0FB,stroke:#7650B6,color:#17243B;
    class facts,options model;
    classDef decision fill:#FFF7E8,stroke:#A56B13,color:#17243B;
    class paired,result decision;
    classDef store fill:#FFFFFF,stroke:#52647B,color:#17243B;
%% INSUFFICIENT is unresolved evidence; it is never converted to a false statement in practice.
%% Blind review hides the earlier verdict, but uses the same model family. Agreement can still be wrong.
