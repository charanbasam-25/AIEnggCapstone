%% The learner's practice flow
%% Current implementation reviewed 7 October 2026.
%% Generated by render_diagrams.py; edit definitions there for matching image exports.
flowchart TB
    choose["Choose a practice set<br/>Polity topic / direct, statements or mixed<br/>Foundation, Standard or Challenging / 1, 5 or 10"]
    bank["Look for eligible checked items<br/>Match topic, style, level, source hash and policy<br/>Validate the saved payload before reuse"]
    quiz["Attempt the accepted questions<br/>Choose A-D or leave an item unanswered<br/>No answer key or option notes before submission"]
    prepare["Prepare the remaining slots<br/>Retrieve sources, draft and run every gate<br/>Revise within the limit; withhold failed drafts"]
    submit["Submit the quiz<br/>Python compares choices with the checked key<br/>Correct / incorrect / skipped"]
    partial["Show the preparation outcome<br/>Partial set: use only accepted questions<br/>Empty set: explain why no quiz is available"]
    review["Review answers and sources<br/>Summary and explanations for every option<br/>Exact quotations with source PDF pages"]
    history["My Practice<br/>Recent completed sets and a mistake notebook<br/>Revisit incorrect or skipped items"]

    choose --> bank
    bank -->|"Missing slots"| prepare
    bank -->|"Eligible reuse"| quiz
    prepare -->|"Accepted items"| quiz
    prepare --> partial
    quiz --> submit
    submit --> review
    review --> history

    classDef source fill:#EDF8F4,stroke:#0B806A,color:#17243B;
    class review source;
    classDef control fill:#EFF4FE,stroke:#2457D6,color:#17243B;
    class choose,quiz,prepare,submit control;
    classDef model fill:#F4F0FB,stroke:#7650B6,color:#17243B;
    classDef decision fill:#FFF7E8,stroke:#A56B13,color:#17243B;
    class partial decision;
    classDef store fill:#FFFFFF,stroke:#52647B,color:#17243B;
    class bank,history store;
%% Changing sources retires the active set. Sidebar navigation preserves an unfinished quiz.
%% Difficulty is a requested prompt setting. Learner history lasts for the current server session.
