%% A bounded draft, review and publication loop
%% Current implementation reviewed 7 October 2026.
%% Generated by render_diagrams.py; edit definitions there for matching image exports.
flowchart TB
    sources["1  Retrieve generation sources<br/>Topic and curated focus -> top 20 -> reranked 5<br/>Full pages, named Article context and source provenance"]
    draft["2  Generate a structured candidate<br/>Question, four options and a proposed key<br/>Use source packet, requested style and revision feedback"]
    format["3  Check format and construct claims<br/>Nonempty, distinct options; supported question structure<br/>Exact-stem duplicate check; safe deterministic binding"]
    answer["4  Verify claims and the answer<br/>Fresh claim retrieval OR direct stem-plus-options retrieval<br/>Quote validation and agreeing blind review<br/>Python resolves a unique key and compares the proposed key"]
    quality["5  Audit question quality<br/>Clarity, single best answer, distractors, wording, topic<br/>Every flag true, PASS and no issues"]
    notes["6  Write and review learning notes<br/>Replace generator prose with fresh summary and A-D notes<br/>Bind source excerpts; review every item against its citations<br/>All item and global explanation checks must pass"]
    gate["7  Python publication decision<br/>Sources + format + answer + quality + explanations<br/>All current-attempt gates must PASS<br/>ACCEPT / REVISE / REJECT"]
    accept["ACCEPT<br/>Recheck at service boundary<br/>Validate and store the item"]
    reject["REJECT<br/>No failed draft in the quiz<br/>Partial set or empty result"]

    sources --> draft
    draft --> format
    format --> answer
    answer --> quality
    quality --> notes
    notes --> gate
    gate -->|All pass| accept
    gate -->|No budget| reject
    gate -.->|REVISE: at most twice; keep generation evidence, retrieve verification evidence afresh| draft

    classDef source fill:#EDF8F4,stroke:#0B806A,color:#17243B;
    class sources,accept source;
    classDef control fill:#EFF4FE,stroke:#2457D6,color:#17243B;
    class format,answer control;
    classDef model fill:#F4F0FB,stroke:#7650B6,color:#17243B;
    class draft,quality,notes model;
    classDef decision fill:#FFF7E8,stroke:#A56B13,color:#17243B;
    class gate,reject decision;
    classDef store fill:#FFFFFF,stroke:#52647B,color:#17243B;
%% Failed format checks skip answer work. Invalid answers skip quality calls; failed quality skips notes.
%% One initial draft + two MCQ revisions. Explanation writing has one local repair; SDK retries are separate.
