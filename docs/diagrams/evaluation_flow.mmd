%% How evaluation results reach the dashboard
%% Current implementation reviewed 7 October 2026.
%% Generated by render_diagrams.py; edit definitions there for matching image exports.
flowchart TB
    dataset["Frozen question dataset<br/>Question text, options and source provenance<br/>Official keys retained for Python grading only"]
    protocol["Recorded run configuration<br/>Dataset, corpus and code hashes<br/>Model, temperature, split, systems and retrieval depths"]
    input["Answering input<br/>Stem and options only<br/>No official key, label audit or diagnostic worksheet"]
    systems["Run the selected answering systems<br/>Strict verifier and/or vanilla RAG<br/>Save evidence, predicted letter or abstention"]
    checkpoint["Write a resumable JSON checkpoint<br/>Save after each system/question result<br/>Resume only when configuration matches"]
    grade["Grade predictions in Python<br/>Correct / wrong / abstained / service error<br/>Precision, coverage, accuracy and breakdowns"]
    ui["How it works -> Evals<br/>Validate and read saved reports; inspect or export"]
    other["Other task-specific reports<br/>Retrieval, legacy judge/stability and generation yield"]

    dataset -->|Questions only| input
    input --> systems
    protocol --> systems
    systems --> grade
    dataset -.->|Keys: grading only| grade
    grade --> checkpoint
    checkpoint -->|Saved data| ui
    other --> ui

    classDef source fill:#EDF8F4,stroke:#0B806A,color:#17243B;
    classDef control fill:#EFF4FE,stroke:#2457D6,color:#17243B;
    class input,systems,grade,ui control;
    classDef model fill:#F4F0FB,stroke:#7650B6,color:#17243B;
    classDef decision fill:#FFF7E8,stroke:#A56B13,color:#17243B;
    classDef store fill:#FFFFFF,stroke:#52647B,color:#17243B;
    class dataset,protocol,checkpoint,other store;
%% 75 mixed regression questions, 13 legacy cases and 16 retrieval queries have different units and references.
